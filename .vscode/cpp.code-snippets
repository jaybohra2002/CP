    "Graph BFS": {
        "prefix": "bfs",
        "body": [
            "// BFS from source src, n = number of nodes",
            "auto bfs = [&](int src, int n, vector<vector<int>>& adj) {",
            "    vector<int> dist(n, -1);",
            "    queue<int> q;",
            "    dist[src] = 0;",
            "    q.push(src);",
            "    while (!q.empty()) {",
            "        int u = q.front(); q.pop();",
            "        for (int v : adj[u]) {",
            "            if (dist[v] == -1) {",
            "                dist[v] = dist[u] + 1;",
            "                q.push(v);",
            "            }",
            "        }",
            "    }",
            "    return dist;",
            "};"
        ],
        "description": "BFS shortest path"
    },

    "Dijkstra": {
        "prefix": "dijkstra",
        "body": [
            "// Dijkstra from src. adj[u] = {v, weight}",
            "auto dijkstra = [&](int src, int n, vector<vector<pii>>& adj) {",
            "    vector<ll> dist(n, LLONG_MAX);",
            "    priority_queue<pll, vector<pll>, greater<pll>> pq;",
            "    dist[src] = 0;",
            "    pq.push({0, src});",
            "    while (!pq.empty()) {",
            "        auto [d, u] = pq.top(); pq.pop();",
            "        if (d > dist[u]) continue;",
            "        for (auto [v, w] : adj[u]) {",
            "            if (dist[u] + w < dist[v]) {",
            "                dist[v] = dist[u] + w;",
            "                pq.push({dist[v], v});",
            "            }",
            "        }",
            "    }",
            "    return dist;",
            "};"
        ],
        "description": "Dijkstra single-source shortest path"
    },

    "Modular Arithmetic": {
        "prefix": "mod",
        "body": [
            "const ll MOD = 1e9 + 7;",
            "ll power(ll base, ll exp, ll mod = MOD) {",
            "    ll result = 1;",
            "    base %= mod;",
            "    while (exp > 0) {",
            "        if (exp & 1) result = result * base % mod;",
            "        base = base * base % mod;",
            "        exp >>= 1;",
            "    }",
            "    return result;",
            "}",
            "ll inv(ll a, ll mod = MOD) { return power(a, mod - 2, mod); }",
            "ll add(ll a, ll b) { return (a + b) % MOD; }",
            "ll mul(ll a, ll b) { return a % MOD * (b % MOD) % MOD; }"
        ],
        "description": "Modular exponentiation, inverse, add, mul"
    },

